# Personal workspace of each team member
local/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Secrets and configuration
.env
.env.*
!.env.example

# Media and real data never belong in the repository
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.m4a
*.aac
data/
sessions/

# The only exception: the released example sessions in testdata/
# (see knowledge-base/standards/data-protection.md, "Beispiel-Sitzungen")
!testdata/sessions/
!testdata/sessions/*/recording.mp4

# Claude Code: personal settings stay local
.claude/settings.local.json

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
